# ==============================================================================
# GridWise Backend Configuration Template
# NOTE: DO NOT put real production credentials or API keys in this template file!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security & CORS (Comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
ALLOWED_HOSTS=*
MAX_REQUEST_BODY_BYTES=1048576 # 1 MB
MAX_NOTE_LENGTH=500

# Authentication (Set AUTH_ENABLED=true to enforce API Key or JWT Bearer)
AUTH_ENABLED=false
API_KEY_SECRET=change_this_to_a_secure_random_api_key_in_production
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider Configuration (mock, openai, gemini, anthropic, custom)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=10.0

# LLM Circuit Breaker & Safety Thresholds
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
CIRCUIT_BREAKER_HALF_OPEN_LIMIT=2

# Security Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_CAPACITY=10
SECURITY_ALERT_THRESHOLD_VIOLATIONS=5

# Mathematical Solver Settings
SOLVER_TIMEOUT_SECONDS=10.0
SOLVER_TOLERANCE=0.01
